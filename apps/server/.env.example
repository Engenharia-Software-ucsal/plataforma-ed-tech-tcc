DATABASE_URL="postgresql://postgres:postgres@localhost:5432/busuucsal"
PORT=3000
NODE_ENV="development"

# Google Authentication (Web Client ID gerado no Google Cloud)
# O Client ID deve ser o tipo "Aplicativo da Web". O App Android e iOS devem estar 
# registrados no mesmo projeto GCP para que o Google permita o fluxo.
GOOGLE_SERVER_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# IA que gera os quizzes (agnóstica a provedor). Sem QUIZ_AI_PROVIDER, o servidor
# usa um gerador de exemplo sem IA real. Provedor suportado hoje: google.
# A chave de cada provedor usa o nome padrão do pacote dele; para o Google:
# GOOGLE_GENERATIVE_AI_API_KEY (crie em aistudio.google.com).
QUIZ_AI_PROVIDER="google"
QUIZ_AI_MODEL="gemini-3.5-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""

# Embeddings dos PDFs das aulas (ingestão). Sem EMBEDDING_PROVIDER, o quiz usa só os
# textos das postagens do Classroom. Trocar de modelo exige reprocessar os PDFs.
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"
