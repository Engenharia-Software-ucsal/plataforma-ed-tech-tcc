{
	"name": "busuucsal-v3",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"lint": "turbo run lint",
		"lint:root": "eslint .",
		"test": "turbo run test",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native --",
		"dev:server": "turbo run dev -F server --",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:migrate": "turbo run db:migrate -F server",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@busuucsal-v3/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@busuucsal-v3/config": "workspace:*",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.1",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.9",
		"turbo": "^2.10.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	},
	"packageManager": "pnpm@11.10.0"
}
